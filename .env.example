# Copy this file to .env and fill in real values for local development.
# In production, never reuse these defaults — the backend refuses to boot
# in NODE_ENV=production with the placeholder secrets below.
#
# To generate strong secrets:
#   JWT_SECRET           → openssl rand -base64 48
#   LIVEKIT_API_SECRET   → openssl rand -base64 32
#   POSTGRES_PASSWORD    → openssl rand -hex 24

# ---- Backend ----
NODE_ENV=development
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0

# Public URL of the backend, used in CORS and links sent to clients.
# In production this MUST be https://.
PUBLIC_BACKEND_URL=http://localhost:3000

# ---- Frontend ----
VITE_BACKEND_URL=http://localhost:3000
VITE_LIVEKIT_URL=ws://localhost:7880

# ---- PostgreSQL ----
POSTGRES_USER=mafia
POSTGRES_PASSWORD=mafia_dev_password
POSTGRES_DB=mafia
DATABASE_URL=postgresql://mafia:mafia_dev_password@localhost:5432/mafia

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- LiveKit ----
# In production: use wss:// and replace the secret with a real value.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_API_SECRET_AT_LEAST_32_CHARS_LONG
LIVEKIT_URL=ws://localhost:7880

# ---- Auth ----
# Secret used to sign session JWTs. Generate with: openssl rand -base64 48
# The server refuses to start in production if this is left as a placeholder.
JWT_SECRET=CHANGE_ME_JWT_SECRET_GENERATE_WITH_openssl_rand_base64_48

# Session lifetime in seconds (default: 30 days)
SESSION_TTL_SECONDS=2592000

# URL of the frontend, used to redirect users after OAuth flows
FRONTEND_URL=http://localhost:5173

# ---- Google OAuth (optional) ----
# Get credentials at https://console.cloud.google.com/apis/credentials
# Leave empty to disable Google sign-in entirely.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
